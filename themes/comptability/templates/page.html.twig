{#
/**
 * @file
 * Page d'accueil : application Vue (routes en #/...).
 * Autres pages Drupal (connexion, réinitialisation du mot de passe…) : rendu classique.
 */
#}
{% if is_front %}
  <div id="vue-app"></div>
{% else %}
  <main class="drupal-page">
    {{ page.highlighted }}
    {{ page.content }}
  </main>
{% endif %}
