<?php

/**
 * @file
 * Thème Comptability : application Vue 3 branchée sur api_solutions.
 */

/**
 * Implements hook_preprocess_HOOK() for html templates.
 */
function comptability_preprocess_html(&$variables) {
  $variables['attributes']['class'][] = 'bg-neu-bg';
  $variables['attributes']['class'][] = 'text-neu-text';
  $variables['attributes']['class'][] = 'antialiased';
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function comptability_preprocess_page(&$variables) {
  $variables['#attached']['drupalSettings']['comptability'] = [
    'siteName' => \Drupal::config('system.site')->get('name') ?: 'Comptabilité',
  ];
}
