<?php

/**
 * @file
 * Hooks for the comptabilty module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function comptabilty_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.comptabilty') {
    return '<p>' . t('Site-specific features for the comptability application.') . '</p>';
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 *
 * Every insert or change of an operation gets its own revision whose log
 * lists the changed fields with old → new values.
 */
function comptabilty_node_presave(NodeInterface $node) {
  if ($node->bundle() === 'operation') {
    \Drupal::service('comptabilty.manager')->prepareOperationRevision($node);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node.
 *
 * Non-admin creates → email the site admin.
 */
function comptabilty_node_insert(NodeInterface $node) {
  \Drupal::service('comptabilty.admin_create_notifier')->notifyIfNeeded($node);
}

/**
 * Implements hook_mail().
 */
function comptabilty_mail($key, &$message, $params) {
  if ($key !== 'admin_create') {
    return;
  }
  /** @var \Drupal\node\NodeInterface $node */
  $node = $params['node'];
  /** @var \Drupal\user\UserInterface $author */
  $author = $params['author'];
  $type = $node->bundle() === 'operation_lot' ? "saisie multiple" : 'opération';

  $message['subject'] = t('Nouvelle @type : @title', [
    '@type' => $type,
    '@title' => $node->label(),
  ]);

  $lines = [
    t('Un utilisateur non administrateur vient de créer une @type.', ['@type' => $type]),
    '',
  ];
  foreach ($params['summary'] as $label => $value) {
    $lines[] = $label . ' : ' . $value;
  }
  $lines[] = '';
  $lines[] = t('Lien : @url', ['@url' => $params['link']]);
  $lines[] = '';
  $lines[] = t('Compte : @name (@mail)', [
    '@name' => $author->getAccountName(),
    '@mail' => $author->getEmail() ?: '—',
  ]);

  $message['body'][] = implode("\n", $lines);
}
