<?php

/**
 * @file
 * Install and update hooks for comptabilty.
 */

/**
 * Use mz_api_integration for « Réglages IA ».
 */
function comptabilty_update_9001() {
  \Drupal::service('module_installer')->install(['mz_api_integration']);

  $state = \Drupal::state();
  $ids = ['gemini' => 'gemini', 'anthropic' => 'claude', 'openai' => 'chatgpt'];
  $config = \Drupal::configFactory()->getEditable('mz_api_integration.settings');
  foreach ((array) $state->get('comptabilty.ai_models', []) as $old => $model) {
    if (isset($ids[$old]) && $model) {
      $config->set("providers.{$ids[$old]}.model", $model);
    }
  }
  foreach ((array) $state->get('comptabilty.ai_keys', []) as $old => $key) {
    if (isset($ids[$old]) && $key) {
      $config->set("providers.{$ids[$old]}.api_key", $key);
    }
  }
  $provider = $state->get('comptabilty.ai_provider');
  if (isset($ids[$provider])) {
    $config->set('ai_provider', $ids[$provider]);
  }
  $config->save();

  $state->deleteMultiple(['comptabilty.ai_provider', 'comptabilty.ai_models', 'comptabilty.ai_keys', 'comptabilty.ai_usage']);
  return t('Réglages IA déplacés vers mz_api_integration.');
}

/**
 * Content type « Lot d'opérations » : historique de la saisie multiple.
 */
function comptabilty_update_9002() {
  $bundle = 'operation_lot';
  if (!\Drupal\node\Entity\NodeType::load($bundle)) {
    \Drupal\node\Entity\NodeType::create([
      'type' => $bundle,
      'name' => "Lot d'opérations",
      'description' => 'Saisie multiple : lignes « montant #libellé », champs communs et opérations créées.',
      'new_revision' => FALSE,
      'display_submitted' => FALSE,
    ])->save();
  }

  // Own storages: raw lines, net total, created operation IDs ("95,96,97").
  $new = [
    'field_lot_lines' => ['type' => 'string_long', 'label' => 'Lignes'],
    'field_lot_total' => ['type' => 'integer', 'label' => 'Total net (Ar)'],
    'field_lot_operations' => ['type' => 'string_long', 'label' => 'Opérations créées (nid)'],
  ];
  foreach ($new as $name => $info) {
    if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('node', $name)) {
      \Drupal\field\Entity\FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'type' => $info['type'],
        'cardinality' => 1,
      ])->save();
    }
  }

  // Shared with « operation »: same storages, same targets.
  $reused = [
    'field_operation_date' => 'Date opération',
    'field_person' => 'Personne',
    'field_category' => 'Catégorie',
    'field_caisse' => 'Caisse',
  ];
  $form = \Drupal::service('entity_display.repository')->getFormDisplay('node', $bundle);
  $view = \Drupal::service('entity_display.repository')->getViewDisplay('node', $bundle);
  foreach ($new + array_map(fn($label) => ['label' => $label], $reused) as $name => $info) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, $name)) {
      continue;
    }
    $values = [
      'field_name' => $name,
      'entity_type' => 'node',
      'bundle' => $bundle,
      'label' => $info['label'],
    ];
    if (isset($reused[$name]) && ($source = \Drupal\field\Entity\FieldConfig::loadByName('node', 'operation', $name))) {
      $values['settings'] = $source->getSettings();
    }
    \Drupal\field\Entity\FieldConfig::create($values)->save();
    $form->setComponent($name, ['region' => 'content']);
    $view->setComponent($name, ['region' => 'content', 'label' => 'inline']);
  }
  $form->save();
  $view->save();

  $role = \Drupal\user\Entity\Role::load('authenticated');
  foreach (['create', 'edit own', 'delete own'] as $op) {
    $role->grantPermission("$op $bundle content");
  }
  $role->save();

  return t("Content type « Lot d'opérations » créé.");
}

/**
 * Enable comptability_access: users only see their own operations.
 *
 * Added as a dependency after comptabilty was installed, so existing sites
 * never enabled it.
 */
function comptabilty_update_9003() {
  if (\Drupal::moduleHandler()->moduleExists('comptability_access')) {
    return t('comptability_access déjà activé.');
  }
  \Drupal::service('module_installer')->install(['comptability_access']);
  return t('comptability_access activé : chaque utilisateur ne voit que ses opérations.');
}

/**
 * Content editors may create persons and see the full person directory.
 */
function comptabilty_update_9004() {
  return _comptabilty_grant_person_to_content_editor();
}

/**
 * Re-apply person permissions for content_editor (prod may have missed 9004).
 */
function comptabilty_update_9005() {
  return _comptabilty_grant_person_to_content_editor();
}

/**
 * Grants content_editor full person create / edit / delete.
 */
function _comptabilty_grant_person_to_content_editor() {
  $role = \Drupal\user\Entity\Role::load('content_editor');
  if (!$role) {
    return t('Rôle content_editor introuvable.');
  }
  foreach ([
    'create person content',
    'edit own person content',
    'edit any person content',
    'delete own person content',
    'delete any person content',
  ] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
  // Drop stale permission caches so hasPermission() sees the grants immediately.
  \Drupal::service('cache.static')->deleteAll();
  if (\Drupal::moduleHandler()->moduleExists('user')) {
    \Drupal::entityTypeManager()->getStorage('user_role')->resetCache(['content_editor']);
  }
  return t('content_editor : création et accès à toutes les personnes.');
}
