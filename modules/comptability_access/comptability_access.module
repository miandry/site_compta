<?php

/**
 * @file
 * Per-user scoping of api_solutions node results.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * Bundles whose nodes are private to their author outside the API too.
 */
const COMPTABILITY_ACCESS_PRIVATE_BUNDLES = ['operation', 'operation_lot'];

/**
 * Whether $account sees every node of $bundle, not only its own.
 */
function comptability_access_sees_all(AccountInterface $account, string $bundle): bool {
  return (int) $account->id() === 1
    || in_array('administrator', $account->getRoles(), TRUE)
    || $account->hasPermission('bypass node access')
    || $account->hasPermission("edit any {$bundle} content");
}

/**
 * Implements hook_node_access().
 *
 * Drupal pages (/node/{id}, revisions) for operations of other users.
 */
function comptability_access_node_access(NodeInterface $node, $op, AccountInterface $account) {
  $bundle = $node->bundle();
  if ($op !== 'view' || !in_array($bundle, COMPTABILITY_ACCESS_PRIVATE_BUNDLES, TRUE)) {
    return AccessResult::neutral();
  }
  $own = $account->isAuthenticated() && (int) $node->getOwnerId() === (int) $account->id();
  return AccessResult::forbiddenIf(!$own && !comptability_access_sees_all($account, $bundle))
    ->cachePerPermissions()
    ->cachePerUser()
    ->addCacheableDependency($node);
}

/**
 * Implements hook_query_TAG_alter() for node_access.
 *
 * Drupal listings (/admin/content, views): without node grants, hook_node_access
 * is not applied to queries, so other users' operations are filtered here.
 */
function comptability_access_query_node_access_alter(AlterableInterface $query) {
  $account = $query->getMetaData('account') ?: \Drupal::currentUser();
  $hidden = array_values(array_filter(
    COMPTABILITY_ACCESS_PRIVATE_BUNDLES,
    fn ($bundle) => !comptability_access_sees_all($account, $bundle)
  ));
  if (!$hidden) {
    return;
  }
  foreach ($query->getTables() as $alias => $table) {
    if (($table['table'] ?? NULL) === 'node_field_data') {
      $query->condition($query->orConditionGroup()
        ->condition("$alias.type", $hidden, 'NOT IN')
        ->condition("$alias.uid", (int) $account->id()));
      return;
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 *
 * /api_solutions/save sets `uid` to the caller on every node save, which would
 * hand ownership of an edited node (and its visibility) to whoever edited it.
 */
function comptability_access_node_presave(NodeInterface $node) {
  if ($node->isNew() || !isset($node->original) || \Drupal::routeMatch()->getRouteName() !== 'api_solutions.save') {
    return;
  }
  $node->setOwnerId($node->original->getOwnerId());
}

/**
 * Implements hook_query_TAG_alter() for entity_query_node.
 *
 * api_solutions lists run entity queries with accessCheck(FALSE), so node
 * grants never apply; non-administrators only get the nodes they created,
 * unless they may "edit any {bundle} content" for the requested bundle.
 */
function comptability_access_query_entity_query_node_alter(AlterableInterface $query) {
  $api_user = \Drupal::service('comptability_access.api_user');
  $route = \Drupal::routeMatch();
  if (!$api_user->isScopedRoute($route->getRouteName())) {
    return;
  }
  if ($api_user->canSeeAll($api_user->requestedBundle())) {
    return;
  }
  $user = $api_user->get();
  $owned = \Drupal::database()->select('node_field_data', 'cao')
    ->fields('cao', ['nid'])
    ->condition('cao.uid', $user ? (int) $user->id() : -1);
  $query->condition('base_table.nid', $owned, 'IN');
}
